{
	"name": "pi-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"packages/coding-agent/examples/extensions/with-deps",
		"packages/coding-agent/examples/extensions/custom-provider-anthropic",
		"packages/coding-agent/examples/extensions/custom-provider-gitlab-duo",
		"packages/coding-agent/examples/extensions/sandbox"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "cd packages/tui && npm run build && cd ../ai && npm run build && cd ../agent && npm run build && cd ../coding-agent && npm run build",
		"check": "biome check --error-on-warnings . && npm run check:test-harness-isolation && npm run check:release-binary-benchmark && npm run check:pinned-deps && npm run check:typescript-toolchain && npm run check:ts-imports && npm run check:coordinator-boundaries && npm run check:clone-config && npm run check:clones && node scripts/run-tsc.mjs --noEmit && npm run check:browser-smoke",
		"format": "biome check --write --error-on-warnings .",
		"check:browser-smoke": "node --test scripts/browser-smoke-node-import-policy.test.mjs && node scripts/check-browser-smoke.mjs",
		"check:clone-config": "node --test scripts/check-production-clones.test.mjs",
		"check:clones": "node scripts/check-production-clones.mjs",
		"check:coordinator-boundaries": "node scripts/check-coordinator-boundaries.mjs",
		"check:model-catalog": "node packages/ai/scripts/check-model-catalog.mjs",
		"check:pinned-deps": "node --test scripts/dependency-security-policy.test.mjs && node scripts/check-pinned-deps.mjs",
		"check:release-binary-benchmark": "node --test scripts/install-standalone.test.mjs scripts/install-standalone-windows.test.mjs scripts/release-binary-rpc-benchmark.test.mjs scripts/release-binary-performance-gate.test.mjs",
		"check:test-harness-isolation": "node --test scripts/test-harness-isolation.test.mjs scripts/release-staging.test.mjs scripts/workspace-test-plan.test.mjs scripts/ci-workflow-performance.test.mjs",
		"coverage:verification-harness": "npm run coverage:verification-harness --workspace=packages/agent && npm run coverage:verification-harness --workspace=packages/coding-agent",
		"check:typescript-toolchain": "node --test scripts/typescript-toolchain.test.mjs",
		"check:ts-imports": "node scripts/check-ts-relative-imports.mjs",
		"profile:tui": "node scripts/profile-coding-agent-node.mjs --mode tui",
		"profile:long-session": "vitest run --root packages/coding-agent test/profiling/host-long-session.profile.test.ts --pool=forks",
		"profile:analyze": "node scripts/analyze-cpuprofile.mjs",
		"profile:growth": "node scripts/report-long-session-growth.mjs",
		"profile:rpc": "node scripts/profile-coding-agent-node.mjs --mode rpc",
		"test": "node scripts/run-workspace-tests.mjs",
	"test:destructive": "npm run test:destructive --workspace=packages/coding-agent",
	"test:destructive:crash": "npm run test:destructive:crash --workspace=packages/coding-agent",
	"test:destructive:chaos": "npm run test:destructive:chaos --workspace=packages/coding-agent",
	"test:destructive:stress": "npm run test:destructive:stress --workspace=packages/coding-agent",
	"test:destructive:soak": "npm run test:destructive:soak --workspace=packages/coding-agent",
		"version:patch": "npm version patch -ws --no-git-tag-version --workspaces-update=false && node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts",
		"version:minor": "npm version minor -ws --no-git-tag-version --workspaces-update=false && node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts",
		"version:major": "npm version major -ws --no-git-tag-version --workspaces-update=false && node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts",
		"version:set": "npm version -ws",
		"accept:local-cold-start": "node scripts/accept-local-cold-start-live.mjs",
		"accept:text-protocol": "node scripts/accept-text-protocol-live.mjs",
		"accept:core-workflows": "node scripts/accept-core-workflows.mjs",
		"accept:parallel-emission": "node scripts/accept-parallel-emission-live.mjs",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"release:promote": "node scripts/release.mjs promote",
		"release:repair": "node scripts/release.mjs repair",
		"prepare": "husky"
	},
	"devDependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.73",
		"@biomejs/biome": "2.3.5",
		"@types/node": "24.12.4",
		"@vitest/coverage-v8": "4.1.10",
		"esbuild": "0.28.1",
		"husky": "9.1.7",
		"jiti": "2.7.0",
		"jscpd": "5.0.14",
		"shx": "0.4.0",
		"tsx": "4.22.1",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=24.18.0"
	},
	"version": "0.0.3",
	"overrides": {
		"nanoid": "3.3.18",
		"protobufjs": "7.6.5",
		"rimraf": "6.1.2",
		"shell-quote": "1.10.0",
		"ws": "8.21.0",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	}
}
