{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"*": ["./*"],
			"@caupulican/pi-ai": ["./packages/ai/src/index.ts"],
			"@caupulican/pi-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@caupulican/pi-ai/tool-repair-registry": [
				"./packages/ai/src/utils/tool-repair/registry.ts"
			],
			"@caupulican/pi-ai/*": [
				"./packages/ai/src/*.ts",
				"./packages/ai/src/providers/*.ts",
				"./packages/ai/src/utils/*.ts"
			],
			"@caupulican/pi-ai/dist/*": ["./packages/ai/src/*"],
			"@caupulican/pi-agent-core": ["./packages/coding-agent/src/kernel/index.ts"],
			"@caupulican/pi-agent-core/node": ["./packages/coding-agent/src/kernel/node.ts"],
			"@caupulican/pi-agent-core/agent": ["./packages/coding-agent/src/kernel/agent.ts"],
			"@caupulican/pi-agent-core/verification-obligations": [
				"./packages/coding-agent/src/kernel/verification-obligations.ts"
			],
			"@caupulican/pi-agent-core/agent-loop": ["./packages/coding-agent/src/kernel/agent-loop.ts"],
			"@caupulican/pi-agent-core/compaction": ["./packages/coding-agent/src/kernel/compaction/index.ts"],
			"@caupulican/pi-agent-core/compaction/*": ["./packages/coding-agent/src/kernel/compaction/*.ts"],
			"@caupulican/pi-agent-core/message-retention": [
				"./packages/coding-agent/src/kernel/session/message-retention.ts"
			],
			"@caupulican/pi-agent-core/messages": ["./packages/coding-agent/src/kernel/messages.ts"],
			"@caupulican/pi-agent-core/paths": ["./packages/coding-agent/src/kernel/utils/paths.ts"],
			"@caupulican/pi-agent-core/process-tree": [
				"./packages/coding-agent/src/kernel/reliability/process-tree.ts"
			],
			"@caupulican/pi-agent-core/reliability": [
				"./packages/coding-agent/src/kernel/reliability/index.ts"
			],
			"@caupulican/pi-agent-core/session": [
				"./packages/coding-agent/src/kernel/session/session-manager.ts"
			],
			"@caupulican/pi-agent-core/shell-output": [
				"./packages/coding-agent/src/kernel/utils/shell-output.ts"
			],
			"@caupulican/pi-agent-core/tool-failure-memory": [
				"./packages/coding-agent/src/kernel/tool-failure-memory.ts"
			],
			"@caupulican/pi-agent-core/provider-request-estimator": [
				"./packages/coding-agent/src/kernel/provider-request-estimator.ts"
			],
			"@caupulican/pi-agent-core/provider-request-image-budget": [
				"./packages/coding-agent/src/kernel/provider-request-image-budget.ts"
			],
			"@caupulican/pi-agent-core/provider-request-planner": [
				"./packages/coding-agent/src/kernel/provider-request-planner.ts"
			],
			"@caupulican/pi-agent-core/provider-tool-projection": [
				"./packages/coding-agent/src/kernel/provider-tool-projection.ts"
			],
			"@caupulican/pi-agent-core/truncate": ["./packages/coding-agent/src/kernel/utils/truncate.ts"],
			"@caupulican/pi-agent-core/types": ["./packages/coding-agent/src/kernel/types.ts"],
			"@caupulican/pi-agent-core/usage": ["./packages/coding-agent/src/kernel/usage.ts"],
			"@caupulican/pi-agent-core/*": ["./packages/coding-agent/src/kernel/*"],
			"@caupulican/pi-adaptative": ["./packages/coding-agent/src/index.ts"],
			"@caupulican/pi-adaptative/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@caupulican/pi-adaptative/*": ["./packages/coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@caupulican/pi-tui": ["./packages/tui/src/index.ts"],
			"@caupulican/pi-tui/*": ["./packages/tui/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**"]
}
