{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"*": ["./*"],
			"@caupulican/pi-ai": ["./packages/ai/src/index.ts"],
			"@caupulican/pi-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@caupulican/pi-ai/tool-repair-registry": [
				"./packages/ai/src/utils/tool-repair/registry.ts"
			],
			"@caupulican/pi-ai/*": [
				"./packages/ai/src/*.ts",
				"./packages/ai/src/providers/*.ts",
				"./packages/ai/src/utils/*.ts"
			],
			"@caupulican/pi-ai/dist/*": ["./packages/ai/src/*"],
			"@caupulican/pi-agent-core": ["./packages/agent/src/index.ts"],
			"@caupulican/pi-agent-core/node": ["./packages/agent/src/node.ts"],
			"@caupulican/pi-agent-core/agent": ["./packages/agent/src/agent.ts"],
			"@caupulican/pi-agent-core/agent-loop": ["./packages/agent/src/agent-loop.ts"],
			"@caupulican/pi-agent-core/compaction": ["./packages/agent/src/compaction/index.ts"],
			"@caupulican/pi-agent-core/compaction/*": ["./packages/agent/src/compaction/*"],
			"@caupulican/pi-agent-core/message-retention": [
				"./packages/agent/src/session/message-retention.ts"
			],
			"@caupulican/pi-agent-core/messages": ["./packages/agent/src/messages.ts"],
			"@caupulican/pi-agent-core/paths": ["./packages/agent/src/utils/paths.ts"],
			"@caupulican/pi-agent-core/process-tree": [
				"./packages/agent/src/reliability/process-tree.ts"
			],
			"@caupulican/pi-agent-core/reliability": [
				"./packages/agent/src/reliability/index.ts"
			],
			"@caupulican/pi-agent-core/session": [
				"./packages/agent/src/session/session-manager.ts"
			],
			"@caupulican/pi-agent-core/shell-output": [
				"./packages/agent/src/utils/shell-output.ts"
			],
			"@caupulican/pi-agent-core/tool-failure-memory": [
				"./packages/agent/src/tool-failure-memory.ts"
			],
			"@caupulican/pi-agent-core/provider-request-estimator": [
				"./packages/agent/src/provider-request-estimator.ts"
			],
			"@caupulican/pi-agent-core/provider-request-image-budget": [
				"./packages/agent/src/provider-request-image-budget.ts"
			],
			"@caupulican/pi-agent-core/provider-request-planner": [
				"./packages/agent/src/provider-request-planner.ts"
			],
			"@caupulican/pi-agent-core/provider-tool-projection": [
				"./packages/agent/src/provider-tool-projection.ts"
			],
			"@caupulican/pi-agent-core/truncate": ["./packages/agent/src/utils/truncate.ts"],
			"@caupulican/pi-agent-core/types": ["./packages/agent/src/types.ts"],
			"@caupulican/pi-agent-core/usage": ["./packages/agent/src/usage.ts"],
			"@caupulican/pi-agent-core/*": ["./packages/agent/src/*"],
			"@caupulican/pi-adaptative": ["./packages/coding-agent/src/index.ts"],
			"@caupulican/pi-adaptative/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@caupulican/pi-adaptative/*": ["./packages/coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@caupulican/pi-tui": ["./packages/tui/src/index.ts"],
			"@caupulican/pi-tui/*": ["./packages/tui/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**"]
}
