{
	"name": "@caupulican/pi-tui",
	"version": "0.98.1",
	"private": true,
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"pi-source": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "node ../../scripts/run-tsc.mjs -p tsconfig.build.json",
		"test": "node --test test/*.test.ts"
	},
	"files": [
		"dist/**/*",
		"native/win32/prebuilds/**/*.node",
		"native/darwin/prebuilds/**/*.node",
		"README.md"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Caupulican/pi-adaptative.git",
		"directory": "packages/tui"
	},
	"engines": {
		"node": ">=24.20.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"get-east-asian-width": "1.6.0",
		"marked": "18.0.11"
	},
	"devDependencies": {
		"@xterm/headless": "6.0.0",
		"chalk": "6.0.0"
	}
}
