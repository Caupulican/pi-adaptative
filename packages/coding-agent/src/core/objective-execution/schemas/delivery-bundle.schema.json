{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pi:delivery:bundle:2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "objective_id",
    "terminal_status",
    "source_revision",
    "acceptance",
    "verification",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "objective_id": {
      "type": "string"
    },
    "terminal_status": {
      "enum": [
        "complete",
        "blocked_external",
        "owner_required",
        "budget_exhausted",
        "cancelled",
        "unrecoverable",
        "semantic_gate_unavailable"
      ]
    },
    "source_revision": {
      "type": "string"
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": true
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
