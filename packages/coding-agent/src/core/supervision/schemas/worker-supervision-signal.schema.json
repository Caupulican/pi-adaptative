{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pi:worker-supervision-signal:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signal_id",
    "objective_id",
    "task_id",
    "attempt_id",
    "action",
    "certificate_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "signal_id": {
      "type": "string"
    },
    "objective_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "action": {
      "enum": [
        "continue",
        "steer_once",
        "request_verifier",
        "stop_and_reroute",
        "request_specialist",
        "request_capability",
        "mark_external_block"
      ]
    },
    "certificate_id": {
      "type": "string"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    }
  }
}
