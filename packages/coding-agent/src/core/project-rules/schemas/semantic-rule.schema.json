{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pi:semantic-rule:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "source",
    "text",
    "phase",
    "consequence",
    "owner",
    "enabled"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "rule_id": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "text": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phase": {
      "enum": [
        "mutation",
        "task_postflight",
        "completion"
      ]
    },
    "consequence": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "owner": {
      "enum": [
        "deterministic",
        "jev"
      ]
    },
    "enabled": {
      "type": "boolean"
    }
  }
}
