{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pi:external-acquisition-record:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "objective_id",
    "source",
    "deterministic_findings",
    "disposition",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string"
    },
    "objective_id": {
      "type": "string"
    },
    "capability_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "deterministic_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "jev_certificate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "disposition": {
      "enum": [
        "allow",
        "rewrite_safe_route",
        "deny"
      ]
    },
    "chosen_route": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    }
  }
}
