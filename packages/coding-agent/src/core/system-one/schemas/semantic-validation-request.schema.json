{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pi-adaptative:integrity:validation-request:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "stage",
    "policy_pack",
    "state",
    "question_ids",
    "impact"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "policy_pack": {
      "type": "object",
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "state": {},
    "question_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "impact": {
      "enum": [
        "read_only",
        "local_reversible",
        "repo_mutation",
        "external_side_effect",
        "destructive"
      ]
    }
  }
}
