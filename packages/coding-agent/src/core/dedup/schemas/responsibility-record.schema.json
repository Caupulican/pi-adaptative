{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pi:dedup:responsibility-record:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "responsibility_id",
    "statement",
    "owner_locations",
    "source_revision",
    "evidence_refs",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "responsibility_id": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "owner_locations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_revision": {
      "type": "string"
    },
    "source_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uniqueness_certificate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "active",
        "superseded",
        "retired",
        "candidate"
      ]
    }
  }
}
